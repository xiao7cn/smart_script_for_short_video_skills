# 复制为 .env 后按本机填写。./start.sh 会自动加载，已有环境变量不会被覆盖。
# .env 已被 gitignore，不会入库。

# MySQL（application.yml 默认也是 root/root，本机密码不同就改这里）
DB_USER=root
DB_PASSWORD=root
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=shanchuang

# 模型密钥：至少配一个。变量名要与 sv_ai_model_config.api_key_env 对得上。
# 也可以只写在 agent/.env，start.sh 会一并加载。
DEEPSEEK_API_KEY=
# Kimi 开放平台。中国站的 key 配 api.moonshot.cn，国际站配 api.moonshot.ai，
# Kimi Code 的 key 配 api.kimi.com/coding，三者互不通用，用错是 401。
MOONSHOT_API_KEY=
# AITECHFLUX_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
