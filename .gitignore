__pycache__/
*.py[cod]

# 生成的文案
output/

# 个人人设配置属于账号资产，默认不入库（模板 config/persona.example.yaml 不受影响）。
# 如果这是你的私有仓库、想把配置一起版本化，删掉下面三行即可。
/persona.yaml
/persona.*.yaml
/.short-video-script/

.DS_Store

# 模型密钥。只放本地，绝不入库——数据库里存的是环境变量名，不是密钥本身
.env
.env.*
!.env.example

# 服务器 SSH 私钥与连接信息。deploy/ 目录本身要入库（部署脚本在里面），
# 所以这里按文件排除，不能整个目录忽略
*.pem
*.key
deploy/remote_server_info.md

# 构建产物与依赖
node_modules/
dist/
target/
.run/
data/uploads/
