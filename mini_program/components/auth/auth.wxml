<view class="auth">
  <view class="auth-brand">
    <view class="auth-logo">
      <image src="/assets/logo.png" mode="aspectFit" />
    </view>
    <view class="font-serif auth-name">闪创工厂</view>
    <view class="font-mono auth-en">AI SHORT-VIDEO SCRIPT STUDIO</view>
  </view>

  <view class="auth-body">
    <view class="auth-switch">
      <view class="auth-switch-item {{method === 'wechat' ? 'auth-switch-on' : ''}}" bindtap="setWechat">一键登录</view>
      <view class="auth-switch-item {{method === 'phone' ? 'auth-switch-on' : ''}}" bindtap="setPhone">手机号登录</view>
    </view>

    <view wx:if="{{method === 'wechat'}}" class="auth-wechat">
      <button class="auth-wx-btn" bindtap="loginWechat" disabled="{{busy}}">
        <image class="auth-wx-icon" src="/assets/wechat.png" mode="aspectFit" />
        <text>一键登录</text>
      </button>
      <view class="auth-hint">推荐 · 最快捷的方式</view>
      <view wx:if="{{err}}" class="auth-err">{{err}}</view>
    </view>

    <view wx:else>
      <view class="auth-field">
        <view class="font-mono auth-label">手机号</view>
        <input class="input" type="number" maxlength="11" placeholder="11 位手机号" value="{{phone}}" bindinput="onPhone" />
      </view>
      <view class="auth-field">
        <view class="font-mono auth-label">验证码</view>
        <view class="auth-code-row">
          <input class="input auth-code-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{code}}" bindinput="onCode" confirm-type="done" bindconfirm="loginPhone" />
          <view class="auth-code-btn {{left > 0 ? 'auth-code-wait' : ''}}" bindtap="sendCode">{{left > 0 ? left + 's' : '获取验证码'}}</view>
        </view>
      </view>
      <view wx:if="{{devCode && left > 0}}" class="auth-dev">
        演示验证码：<text class="font-mono auth-dev-num">{{devCode}}</text>（无真实短信服务）
      </view>
      <view wx:if="{{err}}" class="auth-err">{{err}}</view>
      <view class="btn-primary" style="margin-top: 20px;" bindtap="loginPhone">登录 / 注册</view>
      <view class="auth-hint">未注册的手机号将自动创建账号</view>
    </view>
  </view>

  <view class="auth-legal">登录即代表同意《服务协议》与《隐私政策》。未注册的手机号将自动创建账号。</view>
</view>
