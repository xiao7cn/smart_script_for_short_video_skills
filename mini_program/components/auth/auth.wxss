.auth {
  height: 100%;
  background: var(--card);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.auth-brand {
  padding: 64px 24px 32px;
}
.auth-logo {
  width: 56px;
  height: 56px;
  background: var(--primary);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.auth-logo image {
  width: 32px;
  height: 32px;
}
.auth-name {
  font-weight: 900;
  font-size: 30px;
  line-height: 1.15;
  margin-top: 24px;
}
.auth-en {
  font-size: 11px;
  color: var(--muted-foreground);
  letter-spacing: 1.6px;
  margin-top: 8px;
}
.auth-body {
  padding: 0 24px;
  flex: 1;
}
.auth-switch {
  display: flex;
  background: var(--secondary);
  border-radius: 999px;
  padding: 4px;
  margin-bottom: 24px;
}
.auth-switch-item {
  flex: 1;
  border-radius: 999px;
  padding: 8px 0;
  font-size: 14px;
  font-weight: 700;
  text-align: center;
  color: var(--muted-foreground);
}
.auth-switch-on {
  background: var(--card);
  color: var(--foreground);
  box-shadow: 0 1px 4px rgba(26, 26, 30, 0.08);
}
.auth-wechat {
  padding-top: 24px;
}
.auth-wx-btn {
  width: 100%;
  border-radius: 999px;
  padding: 14px 0;
  font-weight: 700;
  font-size: 15px;
  color: #fff;
  background: #07c160;
  box-shadow: 0 10px 24px rgba(7, 193, 96, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}
.auth-wx-icon {
  width: 20px;
  height: 20px;
  margin-right: 8px;
}
.auth-hint {
  text-align: center;
  font-size: 11px;
  color: var(--muted-foreground);
  margin-top: 8px;
}
.auth-err {
  font-size: 14px;
  color: var(--primary);
  font-weight: 500;
  margin-top: 8px;
}
.auth-field {
  margin-bottom: 12px;
}
.auth-label {
  font-size: 12px;
  color: var(--muted-foreground);
  margin-bottom: 6px;
}
.auth-code-row {
  display: flex;
  gap: 8px;
}
.auth-code-input {
  flex: 1;
}
.auth-code-btn {
  flex-shrink: 0;
  padding: 0 16px;
  border-radius: 14px;
  font-size: 14px;
  font-weight: 700;
  border: 1px solid var(--accent);
  color: var(--accent);
  display: flex;
  align-items: center;
}
.auth-code-wait {
  border-color: var(--border);
  color: rgba(117, 115, 125, 0.6);
}
.auth-dev {
  font-size: 11px;
  color: var(--accent);
  margin-top: 8px;
}
.auth-dev-num {
  font-weight: 700;
}
.auth-legal {
  text-align: center;
  font-size: 11px;
  color: rgba(117, 115, 125, 0.7);
  padding: 24px;
  line-height: 1.6;
}
