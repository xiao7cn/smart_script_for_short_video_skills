# 复制为 .env 后填入真实密钥。.env 已被 .gitignore 忽略。
#
# 变量名要与数据库 sv_ai_model_config.api_key_env 对得上：
#   SELECT scene, provider, api_key_env FROM sv_ai_model_config;
# 数据库里只存变量名，密钥本身只留在 .env。

DEEPSEEK_API_KEY=

# Kimi 开放平台（月之暗面）。变量名沿用官方 SDK 的叫法，和 api.moonshot.cn 这个
# 域名对得上，排查时不会怀疑自己打错了家。
# 注意三个平台的 key 互不通用，用错会拿到 401 invalid_authentication：
#   中国站 platform.kimi.com  → base_url https://api.moonshot.cn/v1
#   国际站 platform.kimi.ai   → base_url https://api.moonshot.ai/v1
#   Kimi Code（会员订阅制）    → base_url https://api.kimi.com/coding/v1
MOONSHOT_API_KEY=

# AITECHFLUX_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Agent 定位 skills 下 Python 脚本的根目录（取件与 ASR 用）
SKILLS_DIR=../skills
